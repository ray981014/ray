local function FormatTime(seconds)
    return string.format("%02d時 %02d分 %02d秒", math.floor(seconds/3600), math.floor((seconds%3600)/60), seconds%60)
end

local function SendDiscordNotification(errorMessage)
    if HasSentDisconnect then return end
    HasSentDisconnect = true
    
    local PlayTime = FormatTime(os.time() - StartTime)
    local Data = {
        ["content"] = "<@" .. MyDiscordID .. "> ⚠️ 帳號已斷線！",
        ["embeds"] = {{
            ["title"] = "🔴 斷線報告: " .. PlaceName,
            ["color"] = 16711680,
            ["fields"] = {
                {["name"] = "玩家", ["value"] = Player.Name .. " (" .. Player.UserId .. ")", ["inline"] = true},
                {["name"] = "遊玩時長", ["value"] = PlayTime, ["inline"] = true},
                {["name"] = "錯誤原因", ["value"] = "```" .. (errorMessage or "無提供錯誤訊息") .. "```", ["inline"] = false},
                {["name"] = "Server ID", ["value"] = "```" .. game.JobId .. "```", ["inline"] = false}
            },
            ["timestamp"] = os.date("!%Y-%m-%dT%H:%M:%SZ")
        }}
    }

    pcall(function()
        local req = (syn and syn.request) or (http and http.request) or http_request or request
        if req then
            req({
                Url = WebhookURL,
                Method = "POST",
                Headers = {["Content-Type"] = "application/json"},
                Body = HttpService:JSONEncode(Data)
            })
        end
    end)
end

local function SetPowerSaving(mode)
    ScreenGui.Enabled = mode
    if mode then
        if setfpscap then setfpscap(10) end
        RunService:Set3dRenderingEnabled(false)
        settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
        if collectgarbage then collectgarbage("collect") end
    else
        if setfpscap then setfpscap(144) end
        RunService:Set3dRenderingEnabled(true)
        settings().Rendering.QualityLevel = Enum.QualityLevel.Automatic
    end
end

task.spawn(function()
    while true do
        if ScreenGui.Enabled then
            local diff = os.time() - StartTime
            TimeLabel.Text = string.format("%02d : %02d : %02d", math.floor(diff/3600), math.floor((diff%3600)/60), diff%60)
            local ping = "N/A"
            pcall(function()
                ping = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
            end)
            PingLabel.Text = "PING: " .. ping .. " ms"
        end
        task.wait(1)
    end
end)

UIS.InputBegan:Connect(function(input, processed)
    if not processed and input.KeyCode == Enum.KeyCode.K then
        SetPowerSaving(not ScreenGui.Enabled)
    end
end)

GuiService.ErrorMessageChanged:Connect(function()
    local msg = GuiService:GetErrorMessage()
    if msg and #msg > 0 then
        SendDiscordNotification(msg)
    end
end)

