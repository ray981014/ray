local friendCache = {}

-- 輔助函式：判斷字串開頭類型（1: 英文字母, 2: 數字, 3: 中文/其他）
local function getNameCategory(name)
    local firstChar = name:sub(1, 1)
    if firstChar:find("%a") then
        return 1
    elseif firstChar:find("%d") then
        return 2
    else
        return 3
    end
end

-- 輔助函式：檢查是否為好友（非同步）
local function checkIsFriend(targetP)
    if friendCache[targetP.UserId] ~= nil then
        return friendCache[targetP.UserId]
    end
    
    local success, isFriend = pcall(function()
        return player:IsFriendsWith(targetP.UserId)
    end)
    
    if success then
        friendCache[targetP.UserId] = isFriend
        return isFriend
    end
    return false
end

