-- 拖曳選單邏輯
local dragging, dragStart, startPos, dragInput

title.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = main.Position
        
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

title.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

-- 更新玩家清單與排序 logic
local function updatePlayerList()
    for _, child in pairs(playerFrame:GetChildren()) do
        if child:IsA("TextButton") then 
            child:Destroy() 
        end 
    end

    local otherPlayers = {}
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= player then
            table.insert(otherPlayers, p)
        end
    end

    -- 排序權重：1. 好友 -> 2. 英文字母 -> 3. 數字 -> 4. 中文/其他
    table.sort(otherPlayers, function(a, b)
        local aIsFriend = checkIsFriend(a)
        local bIsFriend = checkIsFriend(b)

        if aIsFriend ~= bIsFriend then
            return aIsFriend -- 好友優先
        end

        local catA = getNameCategory(a.DisplayName)
        local catB = getNameCategory(b.DisplayName)

        if catA ~= catB then
            return catA < catB -- 字元類別優先度
        end

        return a.DisplayName:lower() < b.DisplayName:lower()
    end)

    -- 產生按鈕
    for idx, p in ipairs(otherPlayers) do
        local isFriend = checkIsFriend(p)
        local prefix = isFriend and "⭐ " or "👤 "

        local btn = Instance.new("TextButton")
        btn.Name = "Player_" .. p.UserId
        btn.Text = " " .. prefix .. p.DisplayName .. " (@" .. p.Name .. ")"
        btn.Size = UDim2.new(1, 0, 0, 28)
        
        -- 好友背景改為深綠背景，文字改為亮綠色
        btn.BackgroundColor3 = isFriend and Color3.fromRGB(30, 55, 38) or Color3.fromRGB(30, 30, 36)
        btn.TextColor3 = isFriend and Color3.fromRGB(100, 240, 130) or Color3.fromRGB(220, 220, 220)
        
        btn.TextSize = 11
        btn.Font = Enum.Font.Gotham
        btn.TextXAlignment = Enum.TextXAlignment.Left
        btn.LayoutOrder = idx
        btn.Parent = playerFrame

        local btnCorner = Instance.new("UICorner")
        btnCorner.CornerRadius = UDim.new(0, 4)
        btnCorner.Parent = btn

        btn.MouseButton1Click:Connect(function()
            targetPlayer = p
            currentState = "Follow"
            print("［狀態變更］開始追蹤玩家: " .. p.Name)
        end)
    end

    playerFrame.CanvasSize = UDim2.new(0, 0, 0, pLayout.AbsoluteContentSize.Y + 8)
end

-- 座標解析
local function parseCoords(text)
    local x, y, z = text:match("([^,]+)%s*,%s*([^,]+)%s*,%s*([^,]+)")
    if x and y and z then return tonumber(x), tonumber(y), tonumber(z) end
    return nil
end

