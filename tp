    local myRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if myRoot then
        local text = string.format("%.1f, %.1f, %.1f", myRoot.Position.X, myRoot.Position.Y, myRoot.Position.Z)
