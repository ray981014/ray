startPosBtn.MouseButton1Click:Connect(function()
    local x, y, z = parseCoords(posInput.Text)
    if x and y and z then
        targetCFrame = CFrame.new(x, y, z)
        currentState = "GoToPos"
        print("［狀態變更］開始飛往座標點")
    else
        posInput.Text = "格式錯誤！需用逗號隔開"
    end
end)

stopBtn.MouseButton1Click:Connect(function()
    currentState = "Idle"
    targetPlayer = nil
    targetCFrame = nil
    print("［狀態變更］已中止所有自動位移")
end)

RunService.Stepped:Connect(function()
    if currentState == "Idle" then return end
    
    local myChar = player.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end
    
    for _, part in pairs(myChar:GetDescendants()) do
        if part:IsA("BasePart") then part.CanCollide = false end
    end
    myRoot.Velocity = Vector3.new(0, 0, 0)
    
    if currentState == "Follow" and targetPlayer then
        local tChar = targetPlayer.Character
        local tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")
        
        if tRoot then
            local goal = tRoot.CFrame * CFrame.new(0, 5, 2)
            myRoot.CFrame = myRoot.CFrame:Lerp(goal, 0.15)
        else
            local pivot = targetPlayer:GetPivot()
            if pivot then myRoot.CFrame = pivot * CFrame.new(0, 5, 0) end
        end
        

    elseif currentState == "GoToPos" and targetCFrame then
        local distance = (myRoot.Position - targetCFrame.Position).Magnitude
        if distance > 60 then
            myRoot.CFrame = targetCFrame 
        else
            myRoot.CFrame = myRoot.CFrame:Lerp(targetCFrame, 0.2)
        end
    end
end)

Players.PlayerAdded:Connect(updatePlayerList)
Players.PlayerRemoving:Connect(updatePlayerList)
updatePlayerList()

print("載入完成")
