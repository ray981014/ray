local function getPadPosition(pad)
    if not pad then return nil end
    if pad:IsA("Model") then
        return pad:GetPivot().Position
    elseif pad:IsA("BasePart") then
        return pad.Position
    else
        local part = pad:FindFirstChildWhichIsA("BasePart", true)
        return part and part.Position or nil
    end
end

local function getPlayerDistanceToPad(pad, root)
    if not root then return math.huge end
    local padPos = getPadPosition(pad)
    return padPos and (root.Position - padPos).Magnitude or math.huge
end

local function countPlayersAtPad(pad, excludeLocal)
    local padPos = getPadPosition(pad)
    if not padPos then return 0 end
    local count = 0
    for _, p in ipairs(Players:GetPlayers()) do
        if excludeLocal and p == player then continue end
        local char = p.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if root and (root.Position - padPos).Magnitude <= DUNGEON_DETECTION_RADIUS then
            count = count + 1
        end
    end
    return count
end

local function findEmptyPad(padsFolder)
    if not padsFolder then return nil end
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local best, bestDist = nil, math.huge
    for _, pad in ipairs(padsFolder:GetChildren()) do
        if not pad.Name:match("DUNGEON_TELEPORTER") then continue end
        if countPlayersAtPad(pad, true) > 0 then continue end
        local d = getPlayerDistanceToPad(pad, root)
        if d < bestDist then
            bestDist = d
            best = pad
        end
    end
    return best
end

local function getCurrentPad(padsFolder)
    if not padsFolder then return nil end
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    local closest, minDist = nil, DUNGEON_DETECTION_RADIUS
    for _, pad in ipairs(padsFolder:GetChildren()) do
        if not pad.Name:match("DUNGEON_TELEPORTER") then continue end
        local d = getPlayerDistanceToPad(pad, root)
        if d <= minDist then
            minDist = d
            closest = pad
        end
    end
    return closest
end

local function tweenToPad(pad)
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local padPos = getPadPosition(pad)
    if not root or not padPos or _G.isMovementActive then
        print(string.format("[AutoDungeon] 距離檢測=無法執行 (root=%s pad=%s isMovementActive=%s)",
            tostring(root ~= nil), tostring(padPos ~= nil), tostring(_G.isMovementActive)))
        return false
    end
    local dist = (padPos - root.Position).Magnitude
    if dist > DUNGEON_MAX_TWEEN_DIST then
        print(string.format(
            "[AutoDungeon] 距離檢測=%.0f/%.0f studs 超過限制 | 自動地下城=%s | 開始地下城=%s | Tween=不執行(保持自動地下城)",
            dist, DUNGEON_MAX_TWEEN_DIST, tostring(_G.FlyEnabled), tostring(_G.DungeonAutoJoin)
        ))
        return false
    end
    print(string.format(
        "[AutoDungeon] 距離檢測=%.0f/%.0f studs 符合限制 | 自動地下城=%s | 開始地下城=%s | Tween=執行",
        dist, DUNGEON_MAX_TWEEN_DIST, tostring(_G.FlyEnabled), tostring(_G.DungeonAutoJoin)
    ))
    _G.IsPadTweenActive = true
    globalTweenTo(CFrame.new(padPos + Vector3.new(0, 3, 0)))
    return true
end

local function detectPadDifficulty(pad)
    if not pad then return nil end
    for _, attrName in ipairs({"Difficulty", "Mode", "Diff"}) do
        local attr = pad:GetAttribute(attrName)
        if attr then return tostring(attr) end
    end
    for _, valName in ipairs({"Difficulty", "Mode", "Diff"}) do
        local val = pad:FindFirstChild(valName, true)
        if val and val:IsA("ValueBase") then return tostring(val.Value) end
    end
    for _, descendant in ipairs(pad:GetDescendants()) do
        if descendant:IsA("TextLabel") or descendant:IsA("TextButton") then
            local text = descendant.Text:lower()
            if text:find("normal") or text:find("普通") then return "Normal"
            elseif text:find("hard") or text:find("困難") then return "Hard"
            elseif text:find("challenge") or text:find("挑戰") or text:find("nightmare") or text:find("噩夢") then return "Challenge"
            end
        end
    end
    return nil
end

local function findDifficultyMatchPad(padsFolder)
    if not padsFolder then return nil end
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local selected = _G.DungeonDifficulty or "Normal"
    local best, bestDist = nil, math.huge
    for _, pad in ipairs(padsFolder:GetChildren()) do
        if not pad.Name:match("DUNGEON_TELEPORTER") then continue end
        if detectPadDifficulty(pad) ~= selected then continue end
        local d = getPlayerDistanceToPad(pad, root)
        if d < bestDist then
            bestDist = d
            best = pad
        end
    end
    return best
end

shouldYieldToPad = function(curHRP)
    if not _G.DungeonAutoJoin then return false end
    if _G.IsPadTweenActive then return true end

    local padsFolder = getPadsFolder()
    if not padsFolder then return false end
    local targetPad = findEmptyPad(padsFolder)
    if not targetPad then
        targetPad = findDifficultyMatchPad(padsFolder)
    end
    if not targetPad then return false end

    local padPos = getPadPosition(targetPad)
    if not padPos then return false end
    if (padPos - curHRP.Position).Magnitude > DUNGEON_MAX_TWEEN_DIST then return false end

    if _G.isMovementActive then globalStopTween() end
    return true
end

local function syncPadDifficulty(pad)
    local remote = pad and pad:FindFirstChild("DungeonSettingsChanged")
    if not remote then return end
    local selected = _G.DungeonDifficulty or "Normal"
    local current = detectPadDifficulty(pad)
    if current and current ~= selected then
        pcall(function() remote:FireServer("Difficulty", selected) end)
    end
end

local function startDungeonAtPad(pad)
    local remote = pad and pad:FindFirstChild("DungeonSettingsChanged")
    if not remote then return end
    dungeonLastStartTime = os.clock()
    task.spawn(function()
        local selected = _G.DungeonDifficulty or "Normal"
        local current = detectPadDifficulty(pad)
        if current and current ~= selected then
            pcall(function() remote:FireServer("Difficulty", selected) end)
            task.wait(0.3)
        end
        pcall(function() remote:FireServer("Start") end)
        print(string.format("[AutoDungeon] %s 已達 2 人以上, 自動開始 (難度: %s)", pad.Name, selected))
    end)
end

task.spawn(function()
