-- ==================================================================
-- ★★★ 回收機制 (真正有效版) ★★★
-- 問題: 原本 guiAttempts[gui] = nil 後，殘留 GUI 會被當成新的重掃
-- 修正:
--   1. retiredGuis 表永久標記已退役的 GUI，findGameCards 直接跳過
--   2. 點滿 CARD_MAX_ATTEMPTS 次 → Destroy() 真的釋放 (含子物件/貼圖)
--   3. prune 只看 Parent == nil (Destroy 後才成立)
--   4. 先看 retiredGuis 再決定要不要 GetDescendants，省 CPU
-- ==================================================================
local retiredGuis = setmetatable({}, { __mode = "k" })  -- 弱鍵，GUI 被銷毀自動清
local guiSeenAt   = {}   -- [ScreenGui] = 第一次看到的時間
local guiAttempts = {}   -- [ScreenGui] = 已嘗試點擊次數
local CARD_SETTLE_TIME  = 0.8
local CARD_MAX_ATTEMPTS = 8
local PRUNE_INTERVAL    = 5
local lastPruneAt       = 0

local function pruneGuiRecords()
    -- ★ Destroy 後 gui.Parent == nil，這裡才真的清得掉
    for gui in pairs(guiSeenAt) do
        if gui.Parent == nil then
            guiSeenAt[gui]   = nil
            guiAttempts[gui] = nil
        end
    end
    for gui in pairs(guiAttempts) do
        if gui.Parent == nil then
            guiAttempts[gui] = nil
        end
    end
end

-- ★ 點滿就真的銷毀，並永久標記退役 (弱鍵表，GUI 沒了自動清)
local function retireGui(gui)
    retiredGuis[gui] = true
    guiSeenAt[gui]   = nil
    guiAttempts[gui] = nil
    pcall(function()
        if gui and gui.Parent then
            gui:Destroy()
        end
    end)
end

