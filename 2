local EnemyCache = {
    Count = 0,
    List  = {},          -- 所有活著的敵人 Model
    Boss  = nil,         -- 最後打的 Boss (優先度最低)
    NormalCount = 0,     -- 小怪數量 (排除 Boss)
}

local function isFriendlyMobCheck(npc)
    return isFriendlyMob(npc)
end

local function rebuildEnemyCache()
    local list = {}
    local normalCount = 0
    local bossModel = nil
    local count = 0

    local enemies = workspace:FindFirstChild("Enemies")
    if enemies then
        for _, npc in ipairs(enemies:GetChildren()) do
            if isFriendlyMobCheck(npc) then continue end
            if npc.Name == "Player" then continue end
            local hum = npc:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                count = count + 1
                list[#list + 1] = npc
                if isLastKillBoss(npc) then
                    if not bossModel then bossModel = npc end
                else
                    normalCount = normalCount + 1
                end
            end
        end
    end

    EnemyCache.Count       = count
    EnemyCache.List        = list
    EnemyCache.NormalCount = normalCount
    EnemyCache.Boss        = bossModel
end

