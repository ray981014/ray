_G.WindUI = WindUI

function WindUI.GenerateGUID() return HttpService:GenerateGUID(false) end

function WindUI.AddSignal(sig, fn)
    local c = sig:Connect(fn)
    table.insert(WindUI.Signals, c)
    return c
end

function WindUI.SafeCallback(fn, ...)
    if not fn then return end
    local ok, err = pcall(fn, ...)
    if not ok then warn("[WindUI] "..tostring(err)) end
end

function WindUI.Tween(obj, t, props, style, dir)
    return TweenService:Create(obj, TweenInfo.new(
        t, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out
    ), props)
end

function WindUI.GetTextColorForHSB(c, threshold)
    local h, s, v = Color3.toHSV(c)
    local brightness = 0.299*c.R + 0.587*c.G + 0.114*c.B
    if brightness > (threshold or 0.5) then
        return Color3.fromHSV(h, 0, 0.05)
    end
    return Color3.fromHSV(h, 0, 0.98)
end

