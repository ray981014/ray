        Visible = false,
        Parent = window._content,
    }, {
        WindUI:New("UIListLayout", {
            Padding = UDim.new(0, 6),
            SortOrder = Enum.SortOrder.LayoutOrder,
        }),
        WindUI:New("UIPadding", {
            PaddingTop = UDim.new(0, 12),
            PaddingBottom = UDim.new(0, 12),
            PaddingLeft = UDim.new(0, 12),
            PaddingRight = UDim.new(0, 12),
        }),
    })
    tab.Container = container

    local function select()
        for _, t in ipairs(window._tabs) do
            t.Selected = false
            t.Container.Visible = false
            t._btn.ImageTransparency = 1
            t._label.TextTransparency = 0.35
        end
        tab.Selected = true
        container.Visible = true
        WindUI:Tween(btn, 0.15, { ImageTransparency = 0 }):Play()
        WindUI:Tween(label, 0.15, { TextTransparency = 0 }):Play()
    end

    tab._btn = btn
    tab._label = label
    tab.Select = function() select() end

    WindUI:AddSignal(btn.InputBegan, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            select()
        end
    end)

    table.insert(window._tabs, tab)
    if #window._tabs == 1 then select() end

    -- 對外元素方法
    function tab:Paragraph(c) Elements.Paragraph(container, c) return self end
    function tab:Button(c) Elements.Button(container, c) return self end
    function tab:Toggle(c) return Elements.Toggle(container, c) end
    function tab:Slider(c) return Elements.Slider(container, c) end
    function tab:Input(c) return Elements.Input(container, c) end
    function tab:Divider() Elements.Divider(container); return self end
    function tab:Section(c)
        local content, sec = Elements.Section(container, c)
        local proxy = {}
        function proxy:Paragraph(cc) Elements.Paragraph(content, cc); return proxy end
        function proxy:Button(cc) Elements.Button(content, cc); return proxy end
        function proxy:Toggle(cc) return Elements.Toggle(content, cc) end
        function proxy:Slider(cc) return Elements.Slider(content, cc) end
        function proxy:Input(cc) return Elements.Input(content, cc) end
        function proxy:Divider() Elements.Divider(content); return proxy end
        return proxy
    end

    return tab
end

--=====================================================================
-- 8. Window
--=====================================================================
function WindUI:CreateWindow(cfg)
    cfg = cfg or {}

    local screenGui = self:New("ScreenGui", {
        Name = "WindUI",
        ResetOnSpawn = false,
        IgnoreGuiInset = true,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        Parent = (gethui and gethui()) or LocalPlayer:WaitForChild("PlayerGui"),
    })

    -- 通知層
    self:InitNotifications(screenGui)

    local main = self:New("Frame", {
        Name = "Main",
        Size = cfg.Size or UDim2.new(0, 580, 0, 460),
        Position = UDim2.new(0.5, 0, 0.5, 0),
        AnchorPoint = Vector2.new(0.5, 0.5),
        BackgroundTransparency = 1,
        Parent = screenGui,
    }, {
        self:New("UIScale", { Scale = self.UIScale }),
    })

    local bg = makeRoundFrame({
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundColor3 = Color3.fromHex("#101010"),
    }, main, 16)

    -- Topbar
    local topbar = self:New("Frame", {
        Name = "Topbar",
        Size = UDim2.new(1, 0, 0, 52),
        BackgroundTransparency = 1,
        Parent = main,
    })

    self:New("TextLabel", {
        Text = cfg.Title or "WindUI",
        TextSize = 16,
        TextXAlignment = Enum.TextXAlignment.Left,
        FontFace = Font.new(self.Font, Enum.FontWeight.SemiBold),
        TextColor3 = Color3.new(1,1,1),
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -160, 1, 0),
        Position = UDim2.new(0, 16, 0, 0),
        Parent = topbar,
    })

    if cfg.Author then
        self:New("TextLabel", {
            Text = cfg.Author,
            TextSize = 12,
            TextXAlignment = Enum.TextXAlignment.Left,
            FontFace = Font.new(self.Font, Enum.FontWeight.Medium),
            TextColor3 = Color3.new(1,1,1),
            TextTransparency = 0.5,
            BackgroundTransparency = 1,
            Position = UDim2.new(0, 16, 0, 30),
            Size = UDim2.new(1, -160, 0, 16),
            Parent = topbar,
        })
    end

    -- 關閉按鈕
    local closeBtn = self:New("TextButton", {
        Text = self:Icon("x"),
        TextSize = 16,
        TextColor3 = Color3.new(1,1,1),
        BackgroundTransparency = 1,
        Size = UDim2.new(0, 30, 0, 30),
        Position = UDim2.new(1, -40, 0.5, -15),
        Font = Enum.Font.GothamBold,
        Parent = topbar,
    })
    self:AddSignal(closeBtn.MouseButton1Click, function()
        main.Visible = false
    end)

    -- Sidebar
    local sidebar = self:New("Frame", {
        Name = "Sidebar",
        Size = UDim2.new(0, 180, 1, -52),
        Position = UDim2.new(0, 0, 0, 52),
        BackgroundTransparency = 1,
        Parent = main,
    })

    local sidebarContent = self:New("ScrollingFrame", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        ScrollBarThickness = 0,
        CanvasSize = UDim2.new(0,0,0,0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        Parent = sidebar,
    }, {
        self:New("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
        self:New("UIPadding", {
            PaddingTop = UDim.new(0, 10), PaddingBottom = UDim.new(0, 10),
            PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8),
        }),
    })

    -- Content
    local content = self:New("Frame", {
        Name = "Content",
        Size = UDim2.new(1, -180, 1, -52),
        Position = UDim2.new(0, 180, 0, 52),
        BackgroundTransparency = 1,
        Parent = main,
    })

    -- 拖曳
    local dragging, dragStart, startPos
    self:AddSignal(topbar.InputBegan, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = main.Position
        end
    end)
    self:AddSignal(UserInputService.InputChanged, function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            main.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)
    self:AddSignal(UserInputService.InputEnded, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    -- Window 物件
    local window = {
        _tabs = {},
        _sidebarContent = sidebarContent,
        _content = content,
        Main = main,
        ScreenGui = screenGui,
        Closed = false,
    }

    function window:Tab(tabCfg)
        return makeTab(self, tabCfg)
    end

    function window:Notify(props)
        return WindUI:Notify(props)
    end

    function window:Close()
        self.Closed = true
        main.Visible = false
    end

    function window:Open()
        self.Closed = false
        main.Visible = true
    end

    function window:Toggle()
        if self.Closed then self:Open() else self:Close() end
    end

    function window:Destroy()
        for _, c in ipairs(WindUI.Signals) do c:Disconnect() end
        screenGui:Destroy()
    end

    function window:SelectTab(index)
        if self._tabs[index] then self._tabs[index]:Select() end
    end

    self.Window = window

    -- Toggle key
    if cfg.ToggleKey then
        self:AddSignal(UserInputService.InputBegan, function(input, processed)
            if processed then return end
            if input.KeyCode == cfg.ToggleKey then
                window:Toggle()
            end
        end)
    end

    return window
end

