WindUI.NotificationHolder = nil

function WindUI:InitNotifications(parent)
    local holder = self:New("Frame", {
        Name = "NotificationHolder",
        Size = UDim2.new(0, 300, 1, -100),
        Position = UDim2.new(1, -20, 0, 20),
        AnchorPoint = Vector2.new(1, 0),
        BackgroundTransparency = 1,
        Parent = parent,
    }, {
        self:New("UIListLayout", {
            Padding = UDim.new(0, 8),
            VerticalAlignment = Enum.VerticalAlignment.Top,
            HorizontalAlignment = Enum.HorizontalAlignment.Right,
        }),
    })
    self.NotificationHolder = holder
end

function WindUI:Notify(props)
    if not self.NotificationHolder then return end

    local card = makeRoundFrame({
        Size = UDim2.new(1, 0, 0, 70),
        AutomaticSize = Enum.AutomaticSize.Y,
        LayoutOrder = -tick(),
        ThemeTag = { ImageColor3 = "Button" },
    }, self.NotificationHolder, 12)

    card.ImageTransparency = 0

    local title = self:New("TextLabel", {
        Text = props.Title or "Notification",
        TextSize = 16,
        TextXAlignment = Enum.TextXAlignment.Left,
        FontFace = Font.new(self.Font, Enum.FontWeight.SemiBold),
        TextColor3 = Color3.new(1,1,1),
        Size = UDim2.new(1, -30, 0, 20),
        Position = UDim2.new(0, 12, 0, 10),
        TextTruncate = Enum.TextTruncate.AtEnd,
        Parent = card,
    })

    if props.Content then
        self:New("TextLabel", {
            Text = props.Content,
            TextSize = 14,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextWrapped = true,
            FontFace = Font.new(self.Font, Enum.FontWeight.Medium),
            TextColor3 = Color3.new(1,1,1),
            TextTransparency = 0.3,
            Size = UDim2.new(1, -24, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            Position = UDim2.new(0, 12, 0, 34),
            Parent = card,
        })
    end

    local close = self:New("TextButton", {
        Text = self:Icon("x"),
        TextSize = 14,
        TextColor3 = Color3.new(1,1,1),
        TextTransparency = 0.3,
        BackgroundTransparency = 1,
        Size = UDim2.new(0, 20, 0, 20),
        Position = UDim2.new(1, -22, 0, 8),
        FontFace = Font.new(self.Font, Enum.FontWeight.Bold),
        Parent = card,
    })

    card.Size = UDim2.new(1, 0, 0, 0)
    self:Tween(card, 0.25, { Size = UDim2.new(1, 0, 0, title.TextBounds.Y + (props.Content and 60 or 26)) }):Play()

    local closed = false
    local function close()
        if closed then return end
        closed = true
        self:Tween(card, 0.2, { ImageTransparency = 1 }):Play()
        for _, child in ipairs(card:GetDescendants()) do
            if child:IsA("TextLabel") then
                self:Tween(child, 0.2, { TextTransparency = 1 }):Play()
            end
        end
        task.delay(0.25, function() card:Destroy() end)
    end

    close.MouseButton1Click:Connect(close)
    task.delay(props.Duration or 5, close)
    return { Close = close }
end

