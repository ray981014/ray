function WindUI:New(class, props, children)
    local inst = Instance.new(class)
    if class == "TextLabel" or class == "TextButton" then
        inst.BackgroundTransparency = 1
        inst.TextColor3 = Color3.new(1,1,1)
        inst.RichText = true
        inst.Font = Enum.Font.Gotham
    elseif class == "Frame" then
        inst.BorderSizePixel = 0
        inst.BackgroundColor3 = Color3.new(1,1,1)
    elseif class == "ImageLabel" or class == "ImageButton" then
        inst.BackgroundTransparency = 1
        inst.BorderSizePixel = 0
    end

    for k, v in next, props or {} do
        if k ~= "ThemeTag" then inst[k] = v end
    end
    for _, c in next, children or {} do c.Parent = inst end

    if props and props.ThemeTag then
        self:AddThemeObject(inst, props.ThemeTag)
    end
    if props and props.FontFace then
        inst.FontFace = props.FontFace
    end
    return inst
end

function WindUI:Icon(name)
    -- 極簡 icon：使用文字符號代替，避免依賴巨大圖示表
    local map = {
        x = "✕", minus = "—", maximize = "⛶", search = "🔍",
        ["chevron-down"] = "⌄", ["arrow-right"] = "→", ["arrow-left"] = "←",
        check = "✓", play = "▶", pause = "⏸", home = "🏠",
        settings = "⚙", user = "👤", info = "ℹ", alert = "⚠",
        trash = "🗑", plus = "+", copy = "📋", lock = "🔒",
    }
    return map[name] or "•"
end

