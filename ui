local Shapes = {
    Circle = { Image="rbxassetid://111665032676235", Rect=Rect.new(512,512,512,512), Radius=512 },
    CircleOutline = { Image="rbxassetid://108556680453287", Rect=Rect.new(512,512,512,512), Radius=512 },
    Squircle = { Image="rbxassetid://89641024074289", Rect=Rect.new(460,460,460,460), Radius=310 },
    SquircleOutline = { Image="rbxassetid://74029063732681", Rect=Rect.new(512,512,512,512), Radius=310 },
    Square = { Image="rbxassetid://82909646051652", Rect=Rect.new(512,512,512,512), Radius=512 },
}

local function makeRoundFrame(props, parent, radius, shapeName)
    radius = radius or 12
    shapeName = shapeName or "Squircle"
    local shape = Shapes[shapeName] or Shapes.Squircle

    local inst = Instance.new("ImageLabel")
    inst.BackgroundTransparency = 1
    inst.BorderSizePixel = 0
    inst.Image = shape.Image
    inst.ScaleType = Enum.ScaleType.Slice
    inst.SliceCenter = shape.Rect
    inst.SliceScale = math.max(radius / shape.Radius, 0.0001)
    inst.Size = props.Size or UDim2.new(1,0,1,0)

    for k, v in next, props or {} do
        if k ~= "ThemeTag" and k ~= "Size" then
            inst[k] = v
        end
    end

    if props and props.ThemeTag then
        inst.Name = inst.Name ~= "" and inst.Name or "RoundFrame"
        WindUI:AddThemeObject(inst, props.ThemeTag)
    end

    if parent then inst.Parent = parent end
    return inst
end

