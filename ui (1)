        FontFace = Font.new(WindUI.Font, Enum.FontWeight.SemiBold),
        TextColor3 = Color3.new(1, 1, 1),
        BackgroundTransparency = 1,
        Size = UDim2.new(0.5, 0, 1, 0),
        Position = UDim2.new(0, 12, 0, 0),
        Parent = frame,
    })

    local keyBtn = WindUI:RoundFrame({
        Size = UDim2.new(0, 60, 0, 28),
        Position = UDim2.new(1, -72, 0.5, -14),
        ThemeTag = { ImageColor3 = "Button" },
    }, frame, 8)
    keyBtn.ImageTransparency = 0.5

    local keyLbl = WindUI:New("TextLabel", {
        Text = value.Name,
        TextSize = 14,
        FontFace = Font.new(WindUI.Font, Enum.FontWeight.SemiBold),
        TextColor3 = Color3.new(1, 1, 1),
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 1, 0),
        Parent = keyBtn,
    })

    local picking = false
    local hit = WindUI:New("TextButton", {
        Text = "", BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 1, 0), Parent = keyBtn,
    })
    WindUI:AddSignal(hit.MouseButton1Click, function()
        picking = true
        keyLbl.Text = "..."
    end)

    WindUI:AddSignal(UserInputService.InputBegan, function(input, processed)
        if processed then return end
        if picking and input.UserInputType == Enum.UserInputType.Keyboard then
            picking = false
            value = input.KeyCode
            keyLbl.Text = value.Name
            WindUI:SafeCallback(cfg.Callback, value)
        elseif not picking and input.KeyCode == value then
            WindUI:SafeCallback(cfg.Callback, value)
        end
    end)

    return {
        Set = function(_, v) value = v; keyLbl.Text = v.Name end,
        Get = function() return value end,
    }
end

-- Section (可折疊)
function Elements.Section(parent, cfg)
    cfg = cfg or {}
    local container = WindUI:New("Frame", {
