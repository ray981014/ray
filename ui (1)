    local header = WindUI:RoundFrame({
        Size = UDim2.new(1, 0, 0, 40),
        ThemeTag = { ImageColor3 = "Button" },
        LayoutOrder = -9999,
    }, container, 10)
    header.ImageTransparency = 0.85

    local arrow = WindUI:New("TextLabel", {
        Text = opened and "⌄" or "›",
        TextSize = 18,
        TextColor3 = Color3.new(1, 1, 1),
        BackgroundTransparency = 1,
        Size = UDim2.new(0, 20, 0, 20),
