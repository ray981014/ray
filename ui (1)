    -- 對外 proxy
    local proxy = {}
    function proxy:Paragraph(c) Elements.Paragraph(content, c); return self end
    function proxy:Button(c) Elements.Button(content, c); return self end
    function proxy:Toggle(c) return Elements.Toggle(content, c) end
    function proxy:Slider(c) return Elements.Slider(content, c) end
    function proxy:Input(c) return Elements.Input(content, c) end
