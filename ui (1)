        TextColor3 = Color3.new(1,1,1),
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -70, 1, 0),
        Position = UDim2.new(0, 12, 0, 0),
        Parent = frame,
    })

    local track = WindUI:New("Frame", {
        Size = UDim2.new(0, 40, 0, 20),
        Position = UDim2.new(1, -52, 0.5, 0),
        AnchorPoint = Vector2.new(0, 0.5),
        BackgroundColor3 = Color3.fromHex("#444"),
        Parent = frame,
    }, {
        WindUI:New("UICorner", { CornerRadius = UDim.new(1, 0) }),
    })

    local knob = WindUI:New("Frame", {
        Size = UDim2.new(0, 16, 0, 16),
        Position = UDim2.new(0, 2, 0.5, 0),
        AnchorPoint = Vector2.new(0, 0.5),
        BackgroundColor3 = Color3.new(1, 1, 1),
        Parent = track,
    }, {
        WindUI:New("UICorner", { CornerRadius = UDim.new(1, 0) }),
    })

    local function set(v, fireCallback)
        state.Value = v
        local goal = v and UDim2.new(1, -18, 0.5, 0) or UDim2.new(0, 2, 0.5, 0)
        WindUI:Tween(knob, 0.2, { Position = goal }):Play()
        local color = v
            and WindUI:GetThemeProperty("Toggle")
            or Color3.fromHex("#444")
        WindUI:Tween(track, 0.2, { BackgroundColor3 = color }):Play()
        if fireCallback ~= false then
            WindUI:SafeCallback(cfg.Callback, v)
        end
    end

    set(state.Value, false)

    local hit = WindUI:New("TextButton", {
        Text = "", BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 1, 0), Parent = frame,
    })
    WindUI:AddSignal(hit.MouseButton1Click, function()
        set(not state.Value)
    end)

    return {
        Set = function(_, v) set(v, false) end,
        Get = function() return state.Value end,
    }
end

-- Slider
function Elements.Slider(parent, cfg)
    cfg = cfg or {}
    local minV = (cfg.Value and cfg.Value.Min) or 0
    local maxV = (cfg.Value and cfg.Value.Max) or 100
    local cur = (cfg.Value and cfg.Value.Default) or minV
    local step = cfg.Step or 1

    local frame = WindUI:RoundFrame({
        Size = UDim2.new(1, 0, 0, 42),
        ThemeTag = { ImageColor3 = "ElementBackground" },
    }, parent, 10)
    frame.ImageTransparency = 0.85

    WindUI:New("TextLabel", {
        Text = cfg.Title or "Slider",
        TextSize = 16,
        TextXAlignment = Enum.TextXAlignment.Left,
        FontFace = Font.new(WindUI.Font, Enum.FontWeight.SemiBold),
        TextColor3 = Color3.new(1, 1, 1),
        BackgroundTransparency = 1,
        Size = UDim2.new(0.5, 0, 1, 0),
        Position = UDim2.new(0, 12, 0, 0),
        Parent = frame,
    })

    local valLbl = WindUI:New("TextLabel", {
        Text = tostring(cur),
        TextSize = 14,
        TextXAlignment = Enum.TextXAlignment.Right,
        FontFace = Font.new(WindUI.Font, Enum.FontWeight.Medium),
        TextColor3 = Color3.new(1,1,1),
        TextTransparency = 0.3,
        BackgroundTransparency = 1,
        Size = UDim2.new(0, 40, 1, 0),
        Position = UDim2.new(1, -52, 0, 0),
        Parent = frame,
    })

    local track = WindUI:New("Frame", {
        Size = UDim2.new(0.4, -20, 0, 4),
        Position = UDim2.new(0.5, 0, 0.5, 0),
        BackgroundColor3 = Color3.fromHex("#333"),
        Parent = frame,
    }, {
        WindUI:New("UICorner", { CornerRadius = UDim.new(1, 0) }),
    })

    local fill = WindUI:New("Frame", {
        Size = UDim2.new((cur - minV) / (maxV - minV), 0, 1, 0),
        BackgroundColor3 = WindUI:GetThemeProperty("Slider"),
        Parent = track,
    }, {
        WindUI:New("UICorner", { CornerRadius = UDim.new(1, 0) }),
    })

    local thumb = WindUI:New("Frame", {
        Size = UDim2.new(0, 12, 0, 12),
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(fill.Size.X.Scale, 0, 0.5, 0),
        BackgroundColor3 = Color3.new(1, 1, 1),
        ZIndex = 2,
        Parent = track,
    }, {
        WindUI:New("UICorner", { CornerRadius = UDim.new(1, 0) }),
    })

    local function set(v, fire)
        v = math.clamp(v, minV, maxV)
        cur = v
        local ratio = (v - minV) / (maxV - minV)
        fill.Size = UDim2.new(ratio, 0, 1, 0)
        thumb.Position = UDim2.new(ratio, 0, 0.5, 0)
        valLbl.Text = tostring(v)
        if fire ~= false then WindUI:SafeCallback(cfg.Callback, v) end
    end

    local dragging = false
    local hit = WindUI:New("TextButton", {
        Text = "", BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 20),
        Position = UDim2.new(0, 0, 0.5, -10),
        Parent = frame,
    })

    local function update(input)
        local rel = (input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X
        rel = math.clamp(rel, 0, 1)
        local raw = minV + rel * (maxV - minV)
        local stepped = math.floor(raw / step + 0.5) * step
        set(stepped)
    end

    WindUI:AddSignal(hit.InputBegan, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            update(input)
        end
    end)
    WindUI:AddSignal(UserInputService.InputChanged, function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch) then
            update(input)
        end
    end)
    WindUI:AddSignal(UserInputService.InputEnded, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    return {
        Set = function(_, v) set(v) end,
        Get = function() return cur end,
    }
end

