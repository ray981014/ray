function WindUI:New(class, props, children)
    local inst = Instance.new(class)
    if class == "TextLabel" or class == "TextButton" then
        inst.BackgroundTransparency = 1
        inst.TextColor3 = Color3.new(1,1,1)
        inst.RichText = true
        inst.Font = Enum.Font.Gotham
        inst.TextSize = 14
    elseif class == "Frame" then
        inst.BorderSizePixel = 0
        inst.BackgroundColor3 = Color3.new(1,1,1)
    elseif class == "ImageLabel" or class == "ImageButton" then
        inst.BackgroundTransparency = 1
        inst.BorderSizePixel = 0
    elseif class == "TextBox" then
        inst.BackgroundTransparency = 1
        inst.ClearTextOnFocus = false
        inst.Text = ""
        inst.Font = Enum.Font.Gotham
        inst.TextSize = 14
        inst.TextColor3 = Color3.new(1,1,1)
    end

    for k, v in next, props or {} do
        if k ~= "ThemeTag" then
            inst[k] = v
        end
    end
    for _, c in next, children or {} do
        c.Parent = inst
    end

    -- 先設 Parent，再套主題
    if props and props.ThemeTag then
        self:AddThemeObject(inst, props.ThemeTag)
    end
    if props and props.FontFace then
        inst.FontFace = props.FontFace
    end
    return inst
end

-- 建立圓角框（修正：先 Parent 後 ThemeTag）
function WindUI:RoundFrame(props, parent, radius, shapeName)
    radius = radius or 12
    shapeName = shapeName or "Squircle"
    local shape = Shapes[shapeName] or Shapes.Squircle

    local inst = Instance.new("ImageLabel")
    inst.BackgroundTransparency = 1
    inst.BorderSizePixel = 0
    inst.Image = shape.Image
    inst.ScaleType = Enum.ScaleType.Slice
    inst.SliceCenter = shape.Rect
    inst.SliceScale = math.max(radius / shape.Radius, 0.0001)
    inst.Size = UDim2.new(1, 0, 1, 0)

    for k, v in next, props or {} do
        if k ~= "ThemeTag" and k ~= "Size" and k ~= "Parent" then
            inst[k] = v
        end
    end

    -- 關鍵：先設 Parent
    if parent then
        inst.Parent = parent
    elseif props and props.Parent then
        inst.Parent = props.Parent
    end

    -- 再套主題
    if props and props.ThemeTag then
        self:AddThemeObject(inst, props.ThemeTag)
    end

    -- 加圓角（ImageLabel 無法用 UICorner，改用 UICorner 只在 Frame 上生效，
    -- 這裡 ImageLabel 用 Slice 圖即可，若載入失敗仍顯示純色）
    return inst
end

