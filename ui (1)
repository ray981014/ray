function WindUI:CreateWindow(cfg)
    cfg = cfg or {}

    local screenGui = self:New("ScreenGui", {
        Name = "WindUI",
        ResetOnSpawn = false,
        IgnoreGuiInset = true,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        Parent = (gethui and gethui()) or LocalPlayer:WaitForChild("PlayerGui"),
    })

    self:InitNotifications(screenGui)

    local main = self:New("Frame", {
        Name = "Main",
        Size = cfg.Size or UDim2.new(0, 580, 0, 460),
        Position = UDim2.new(0.5, 0, 0.5, 0),
        AnchorPoint = Vector2.new(0.5, 0.5),
        BackgroundTransparency = 1,
        Parent = screenGui,
    }, {
        self:New("UIScale", { Scale = self.UIScale }),
    })

    -- 主背景（深色圓角）
    local bg = self:RoundFrame({
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundColor3 = self:GetThemeProperty("WindowBackground"),
    }, main, 16)

    -- Topbar
    local topbar = self:New("Frame", {
        Name = "Topbar",
        Size = UDim2.new(1, 0, 0, 52),
        BackgroundTransparency = 1,
        Parent = main,
    })

    self:New("TextLabel", {
        Text = cfg.Title or "WindUI",
        TextSize = 16,
        TextXAlignment = Enum.TextXAlignment.Left,
        FontFace = Font.new(self.Font, Enum.FontWeight.SemiBold),
        TextColor3 = Color3.new(1, 1, 1),
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -160, 0, 22),
        Position = UDim2.new(0, 16, 0, 10),
        Parent = topbar,
    })

    if cfg.Author then
        self:New("TextLabel", {
            Text = cfg.Author,
            TextSize = 12,
            TextXAlignment = Enum.TextXAlignment.Left,
            FontFace = Font.new(self.Font, Enum.FontWeight.Medium),
            TextColor3 = Color3.new(1, 1, 1),
            TextTransparency = 0.5,
            BackgroundTransparency = 1,
            Position = UDim2.new(0, 16, 0, 32),
            Size = UDim2.new(1, -160, 0, 16),
            Parent = topbar,
        })
    end

    local closeBtn = self:New("TextButton", {
        Text = self.Icon("x"),
        TextSize = 16,
        TextColor3 = Color3.new(1, 1, 1),
        BackgroundTransparency = 1,
        Size = UDim2.new(0, 30, 0, 30),
        Position = UDim2.new(1, -40, 0.5, -15),
        Font = Enum.Font.GothamBold,
        Parent = topbar,
    })
    self:AddSignal(closeBtn.MouseButton1Click, function()
        main.Visible = false
    end)

    -- Sidebar
    local sidebar = self:New("Frame", {
        Name = "Sidebar",
        Size = UDim2.new(0, 180, 1, -52),
        Position = UDim2.new(0, 0, 0, 52),
        BackgroundTransparency = 1,
        Parent = main,
    })

    local sidebarContent = self:New("ScrollingFrame", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        ScrollBarThickness = 0,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        Parent = sidebar,
    }, {
        self:New("UIListLayout", {
            Padding = UDim.new(0, 6),
            SortOrder = Enum.SortOrder.LayoutOrder,
        }),
        self:New("UIPadding", {
            PaddingTop = UDim.new(0, 10),
            PaddingBottom = UDim.new(0, 10),
            PaddingLeft = UDim.new(0, 8),
            PaddingRight = UDim.new(0, 8),
        }),
    })

    -- Content
    local content = self:New("Frame", {
        Name = "Content",
        Size = UDim2.new(1, -180, 1, -52),
        Position = UDim2.new(0, 180, 0, 52),
        BackgroundTransparency = 1,
        Parent = main,
    })

    -- 拖曳
    local dragging, dragStart, startPos
    self:AddSignal(topbar.InputBegan, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = main.Position
        end
    end)
    self:AddSignal(UserInputService.InputChanged, function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            main.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)
    self:AddSignal(UserInputService.InputEnded, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    -- Window 物件
    local window = {
        _tabs = {},
        _selectedTab = nil,
        _sidebarContent = sidebarContent,
        _content = content,
        Main = main,
        ScreenGui = screenGui,
        Closed = false,
    }

    function window:Tab(tabCfg)
        return makeTab(self, tabCfg)
    end
    function window:Notify(props)
        return WindUI:Notify(props)
    end
    function window:Close()
        self.Closed = true
        main.Visible = false
    end
    function window:Open()
        self.Closed = false
        main.Visible = true
    end
    function window:Toggle()
        if self.Closed then self:Open() else self:Close() end
    end
    function window:Destroy()
        for _, c in ipairs(WindUI.Signals) do c:Disconnect() end
        screenGui:Destroy()
    end
    function window:SelectTab(index)
        if self._tabs[index] then self._tabs[index]:Select() end
    end
    function window:SetTheme(name)
        WindUI:SetTheme(name)
    end

    self.Window = window

    if cfg.ToggleKey then
        self:AddSignal(UserInputService.InputBegan, function(input, processed)
            if processed then return end
            if input.KeyCode == cfg.ToggleKey then
                window:Toggle()
            end
        end)
    end

    return window
end

