-- 8. Tab
--=====================================================================
local function makeTab(window, cfg)
    cfg = cfg or {}
    local tab = {
        Title = cfg.Title or "Tab",
        Selected = false,
        Container = nil,
    }

    local btn = WindUI:RoundFrame({
        Size = UDim2.new(1, -8, 0, 34),
        ThemeTag = { ImageColor3 = "Button" },
    }, window._sidebarContent, 10)
    btn.ImageTransparency = 1

    local label = WindUI:New("TextLabel", {
        Text = tab.Title,
        TextSize = 15,
        TextXAlignment = Enum.TextXAlignment.Left,
        FontFace = Font.new(WindUI.Font, Enum.FontWeight.Medium),
        TextColor3 = Color3.new(1, 1, 1),
        TextTransparency = 0.35,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -20, 1, 0),
        Position = UDim2.new(0, 12, 0, 0),
        Parent = btn,
    })

    local container = WindUI:New("ScrollingFrame", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        ScrollBarThickness = 0,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        Visible = false,
        Parent = window._content,
    }, {
        WindUI:New("UIListLayout", {
            Padding = UDim.new(0, 6),
            SortOrder = Enum.SortOrder.LayoutOrder,
        }),
        WindUI:New("UIPadding", {
            PaddingTop = UDim.new(0, 12),
            PaddingBottom = UDim.new(0, 12),
            PaddingLeft = UDim.new(0, 12),
            PaddingRight = UDim.new(0, 12),
        }),
    })
    tab.Container = container

    local function select()
        for _, t in ipairs(window._tabs) do
            t.Selected = false
            t.Container.Visible = false
            t._btn.ImageTransparency = 1
            t._label.TextTransparency = 0.35
        end
        tab.Selected = true
        container.Visible = true
        WindUI:Tween(btn, 0.15, { ImageTransparency = 0 }):Play()
        WindUI:Tween(label, 0.15, { TextTransparency = 0 }):Play()
        window._selectedTab = tab
    end

    tab._btn = btn
    tab._label = label
    tab.Select = select

    WindUI:AddSignal(btn.InputBegan, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            select()
        end
    end)

    table.insert(window._tabs, tab)
    if #window._tabs == 1 then select() end

    function tab:Paragraph(c) Elements.Paragraph(container, c); return self end
    function tab:Button(c) Elements.Button(container, c); return self end
    function tab:Toggle(c) return Elements.Toggle(container, c) end
    function tab:Slider(c) return Elements.Slider(container, c) end
    function tab:Input(c) return Elements.Input(container, c) end
    function tab:Dropdown(c) return Elements.Dropdown(container, c) end
    function tab:Keybind(c) return Elements.Keybind(container, c) end
    function tab:ProgressBar(c) return Elements.ProgressBar(container, c) end
    function tab:Divider() Elements.Divider(container); return self end
    function tab:Section(c) return Elements.Section(container, c) end

    return tab
end

