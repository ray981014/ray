-- 4. 主題系統（修正版）
--=====================================================================
local ThemeObjects = setmetatable({}, { __mode = "k" })

function WindUI:AddThemeObject(obj, tag)
    ThemeObjects[obj] = tag
    self:UpdateThemeForObject(obj)
end

function WindUI:GetThemeProperty(name)
    local theme = self.Theme or self.Themes.Dark
    local v = theme[name]
    if v == nil then return nil end
    if type(v) == "string" and v:sub(1, 1) == "#" then
        return Color3.fromHex(v)
    end
    return v
end

function WindUI:UpdateThemeForObject(obj)
    local tag = ThemeObjects[obj]
    if not tag then return end
    if not obj or not obj.Parent then
        ThemeObjects[obj] = nil
        return
    end
    for prop, key in pairs(tag) do
        local v = self:GetThemeProperty(key)
        if v ~= nil then
            pcall(function() obj[prop] = v end)
        end
    end
end

function WindUI:SetTheme(name)
    if not self.Themes[name] then
        warn("[WindUI] Theme not found: "..tostring(name))
        return
    end
    self.Theme = self.Themes[name]
    for obj in pairs(ThemeObjects) do
        self:UpdateThemeForObject(obj)
    end
end

