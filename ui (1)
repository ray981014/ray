-- 10. Config 存讀檔 (簡化)
--=====================================================================
WindUI.Config = {}
function WindUI.Config.New(folder)
    if not writefile then
        warn("[WindUI.Config] 此執行器不支援 writefile")
        return nil
    end
    local base = "WindUI/"..(folder or "Config").."/"
    if not isfolder("WindUI") then makefolder("WindUI") end
    if not isfolder(base) then makefolder(base) end

    local cfg = { Path = base, Data = {} }

    function cfg:Save(name, data)
        if not isfolder(self.Path) then makefolder(self.Path) end
        writefile(self.Path..name..".json", HttpService:JSONEncode(data))
    end
    function cfg:Load(name)
        local p = self.Path..name..".json"
        if isfile and isfile(p) then
            return HttpService:JSONDecode(readfile(p))
        end
        return nil
    end
    function cfg:List()
        local out = {}
        if listfiles then
            for _, f in ipairs(listfiles(self.Path)) do
                local n = f:match("([^/\\]+)%.json$")
                if n then table.insert(out, n) end
            end
        end
        return out
    end
    return cfg
end

