        Position = UDim2.new(0.5, 0, 0.5, 0),
        BackgroundColor3 = WindUI:GetThemeProperty("ProgressBarTrack"),
        BackgroundTransparency = WindUI:GetThemeProperty("ProgressBarTrackTransparency") or 0.6,
        Parent = frame,
    }, {
        WindUI:New("UICorner", { CornerRadius = UDim.new(1, 0) }),
    })

    local fill = WindUI:New("Frame", {
        Size = UDim2.new(0, 0, 1, 0),
        BackgroundColor3 = WindUI:GetThemeProperty("Slider"),
        Parent = track,
    }, {
        WindUI:New("UICorner", { CornerRadius = UDim.new(1, 0) }),
    })

    local function set(v)
        v = math.clamp(v, minV, maxV)
        cur = v
        local ratio = (maxV == minV) and 0 or (v - minV) / (maxV - minV)
        WindUI:Tween(fill, 0.15, { Size = UDim2.new(ratio, 0, 1, 0) }):Play()
        valLbl.Text = string.format("%d%%", math.floor(ratio * 100 + 0.5))
    end

    set(cur)

    return {
        Set = function(_, v) set(v) end,
        Get = function() return cur end,
    }
end

-- Dropdown (簡化版，用按鈕循環選擇)
function Elements.Dropdown(parent, cfg)
    cfg = cfg or {}
    local values = cfg.Values or {}
    local idx = 1
    for i, v in ipairs(values) do
        if v == cfg.Value then idx = i break end
    end

    local frame = WindUI:RoundFrame({
        Size = UDim2.new(1, 0, 0, 42),
        ThemeTag = { ImageColor3 = "ElementBackground" },
    }, parent, 10)
    frame.ImageTransparency = 0.85

    WindUI:New("TextLabel", {
        Text = cfg.Title or "Dropdown",
        TextSize = 15,
        TextXAlignment = Enum.TextXAlignment.Left,
        FontFace = Font.new(WindUI.Font, Enum.FontWeight.SemiBold),
        TextColor3 = Color3.new(1, 1, 1),
        BackgroundTransparency = 1,
        Size = UDim2.new(0.5, 0, 1, 0),
        Position = UDim2.new(0, 12, 0, 0),
        Parent = frame,
    })

    local valLbl = WindUI:New("TextLabel", {
        Text = tostring(values[idx] or "--"),
        TextSize = 14,
        TextXAlignment = Enum.TextXAlignment.Right,
        FontFace = Font.new(WindUI.Font, Enum.FontWeight.Medium),
        TextColor3 = Color3.new(1,1,1),
        TextTransparency = 0.2,
        BackgroundTransparency = 1,
        Size = UDim2.new(0, 120, 1, 0),
        Position = UDim2.new(1, -130, 0, 0),
        TextTruncate = Enum.TextTruncate.AtEnd,
        Parent = frame,
    })

    local hit = WindUI:New("TextButton", {
        Text = "", BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 1, 0),
        Parent = frame,
    })

    WindUI:AddSignal(hit.MouseButton1Click, function()
        if #values == 0 then return end
        idx = idx % #values + 1
        valLbl.Text = tostring(values[idx])
        WindUI:SafeCallback(cfg.Callback, values[idx])
    end)

    return {
        Select = function(_, v)
            for i, x in ipairs(values) do
                if x == v then idx = i; valLbl.Text = tostring(x); break end
            end
        end,
        Get = function() return values[idx] end,
    }
end

