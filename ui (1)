    function proxy:Keybind(c) return Elements.Keybind(content, c) end
    function proxy:ProgressBar(c) return Elements.ProgressBar(content, c) end
    function proxy:Divider()
        WindUI:New("Frame", {
            Size = UDim2.new(1, 0, 0, 1),
            BackgroundColor3 = Color3.new(1, 1, 1),
            BackgroundTransparency = 0.85,
            Parent = content,
        })
        return self
    end
    return proxy
end

